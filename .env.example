# Copy to .env (docker compose reads it). Every value is optional.

# LLM for OCR-text -> JSON extraction and the "Why?" rephrasing. Without a key the
# regex extractor and template text are used; verdicts never depend on the LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_ENABLED=auto

# Salt for hashing device ids. CHANGE THIS for any real deployment.
USER_HASH_SALT=change-me

# 1 = never call external services (Open-Meteo, OpenStreetMap). Use on stage if Wi-Fi is unreliable.
DAWACHECK_OFFLINE=0

# Admin screen (/app/officer/admin): add bans, review farmer-added products. Empty = admin disabled.
ADMIN_TOKEN=

# Background queue on Vercel (Upstash QStash). Not needed with Redis (Docker/Render).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# PUBLIC_URL=https://your-domain   # defaults to Vercel's production URL
# Render/Docker without a separate worker service: run the RQ worker inside the API container
# RUN_WORKER=1
